# ---------------------------------------------------------------------------
# Home Procurement Platform — environment template
# Copy to `.env` (docker compose reads it automatically):  cp .env.example .env
# All money values are in Toman (integer).
# ---------------------------------------------------------------------------

# --- Postgres (used by the `postgres` compose service and by the backend) ---
POSTGRES_USER=torob
POSTGRES_PASSWORD=torob
POSTGRES_DB=torob_home
POSTGRES_PORT=5432

# --- Backend ---
# Inside docker compose the host is the `postgres` service.
DATABASE_URL=postgresql+psycopg://torob:torob@postgres:5432/torob_home
# For backend running directly on the host, use:
# DATABASE_URL=postgresql+psycopg://torob:torob@localhost:5432/torob_home
TEST_DATABASE_URL=postgresql+psycopg://torob:torob@postgres:5432/torob_home_test

BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- LLM (backend only — never sent to the frontend) -----------------------
# One client, used by BOTH the intent interpreter and the complementary-product
# selector. Every value is read from the environment; none is hardcoded in
# Python. Any OpenAI-compatible chat-completions endpoint works.
#
# LLM_API_KEY and LLM_MODEL are REQUIRED. With either missing, the intent
# endpoint fails with 503 and says so by name — there is no keyword-matching
# fallback, because a search that silently stops understanding is worse than one
# that admits it cannot answer.
#
# LLM_MODEL is the ONLY model this application will ever contact. There is no
# default, no fallback list, and no second model to switch to:
#   - a retry (rate limit, token budget, response format) re-sends the SAME id
#   - a 429 for this model stays a 429 for this model and surfaces as 503
#   - a model id is never hardcoded in the source
# Adding a second model to this file would do nothing; the code reads only this
# variable.
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free
# The endpoint the model is reachable on. Most models speak
# `<base>/chat/completions`; some model families (for example "decisions" models)
# are served on a different path entirely and are rejected on this one with a 400
# naming the correct path. The application will not move you to it.
LLM_BASE_URL=https://openrouter.ai/api/v1
# 0 keeps the model deterministic, which intent extraction wants
LLM_TEMPERATURE=0
# A reasoning model spends tokens before it answers. If it runs out mid-thought it
# replies with no answer at all, which the client detects and retries with
# LLM_MAX_TOKENS_ON_TRUNCATION rather than reporting an outage. Raise these if
# your model thinks for longer than this.
LLM_MAX_TOKENS=2000
LLM_MAX_TOKENS_ON_TRUNCATION=6000
LLM_TRUNCATION_RETRIES=1
# How hard the model may think before answering, sent as
# `reasoning: {"effort": ...}` (OpenRouter's `reasoning.effort`).
# One of: minimal | low | medium | high. Anything else is refused at startup,
# naming the field, rather than sent to the provider.
#
# This applies to the SEARCH INTERPRETATION call only. Interpreting a sentence is a
# small structured judgement, and a reasoning model that thinks at length about one
# often spends the whole token budget before answering — which is what the retry
# above papers over. `low` makes the first attempt the answer instead. It does not
# change LLM_MAX_TOKENS: that is the budget, this is how much of it gets used.
#
# Candidate selection and the recommendation reasoning deliberately do NOT send
# this, so they keep whatever the provider does by default.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=25
# Sent as HTTP-Referer / X-Title; some providers require both to be present
LLM_REFERER=https://torob.com
LLM_TITLE=Home Procurement
# Log the full LLM exchange: both prompts, and the whole reply including the
# model's `reasoning` and `reasoning_details` — otherwise invisible, and the only
# way to see why a model answered as it did or ran out of budget mid-thought.
# DEBUGGING ONLY. The prompt contains the user's own words, and people type rooms,
# areas, budgets and sometimes addresses into this app. Keep it off in production.
# The API key is redacted either way.
LLM_LOG_PAYLOADS=false
# Per-field character cap so one long reasoning trace cannot flood the log. 0 = no limit.
LLM_LOG_PAYLOAD_LIMIT=20000
# How many brands the interpreter is shown, to bound the prompt's cost
INTENT_TAXONOMY_MAX_BRANDS=40

# How many catalogue products the complementary selector may choose from, and
# how many it may return. A project asks once for the whole project, so the pool
# is merged across items.
COMPLEMENTARY_CANDIDATE_LIMIT=24
COMPLEMENTARY_MAX_RESULTS=6

# --- Frontend ---------------------------------------------------------------
# Baked into the frontend build (Vite needs the value at build time)
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173


# Product catalogue ----------------------------------------------------------
# The backend owns the product catalogue and reads this JSON file from disk.
# Relative paths resolve from the backend package directory.
CATALOG_PATH=../data/catalog/products_70_enriched.json

# --- Product source --------------------------------------------------------
# Where products come from. Two values, chosen here and nowhere else:
#   local       = the enriched JSON catalog above (default; current behaviour)
#   torob_mcp   = Torob's own MCP server, asked for products over HTTP
# Any other value fails at startup with a clear message rather than falling back.
PRODUCT_SOURCE=local
# Read only when PRODUCT_SOURCE=torob_mcp. Never defaulted in code: a deployment
# that asks for Torob names the server it means.
TOROB_MCP_URL=https://torob-mcp.dev/mcp
